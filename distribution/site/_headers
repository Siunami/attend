/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/releases/*
  Cache-Control: public, max-age=31536000, immutable

/releases/:version/install.sh
  Content-Type: text/x-shellscript; charset=utf-8

/latest.json
  Cache-Control: no-store

/install-prompt.txt
  Cache-Control: no-store

/install.sh
  Cache-Control: no-store
  Content-Type: text/x-shellscript; charset=utf-8
